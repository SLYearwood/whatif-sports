# Copy to .env and fill in. .env is gitignored; never commit real values.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Run `whatif voices` to list the voice ids on your account (your clone shows first)
ELEVENLABS_VOICE_ID=

# Optional ElevenLabs tuning (defaults shown)
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STABILITY=0.45
# ELEVENLABS_SIMILARITY=0.8
# ELEVENLABS_STYLE=0.15
# ELEVENLABS_SPEED=1.05
# Refuse a render that would send more than this many uncached characters to the API
# WHATIF_MAX_TTS_CHARS=3000

# TTS backend: elevenlabs, flite (ffmpeg, offline) or sapi (Windows voices, offline).
# Leave empty to use elevenlabs when its key + voice id are set, otherwise flite.
WHATIF_TTS=
# flite voices: kal, kal16, awb, rms, slt
WHATIF_FLITE_VOICE=rms
# Optional: full path to ffmpeg.exe if it is not on PATH
FFMPEG_PATH=
