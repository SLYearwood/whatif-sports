# Copy to .env and fill in. .env is gitignored; never commit real values.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Milestone 1 (offline) settings
# TTS backend: flite (ffmpeg, any OS) or sapi (Windows built-in voices, better quality)
WHATIF_TTS=flite
# flite voices: kal, kal16, awb, rms, slt
WHATIF_FLITE_VOICE=rms
# Optional: full path to ffmpeg.exe if it is not on PATH
FFMPEG_PATH=
